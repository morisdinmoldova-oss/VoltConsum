{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "voltconsum-raport-energetic.json",
      "**/.git/**",
      "**/.*",
      "**/node_modules/**",
      "**/firebase-debug.log",
      "**/firebase-debug.*.log"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
